{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiaiaiai.org/mind/schema/manifest/v3",
  "title": "Mind Manifest",
  "description": "Provider-neutral composition contract for one concrete or abstract Mind publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "mind",
    "contract",
    "modules",
    "context",
    "loading",
    "validation"
  ],
  "$defs": {
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "module_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/module_id"},
      "uniqueItems": true
    },
    "entity_type": {
      "type": "string",
      "enum": ["unspecified", "person", "organization", "agent", "project", "product"]
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"$ref": "#/$defs/entity_type"},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "stable_semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  },
  "properties": {
    "schema_version": {
      "description": "Version of the manifest machine shape.",
      "const": 3
    },
    "protocol": {
      "description": "Protocol identity and semantic version used by this mind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "mind"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "mind": {
      "description": "Stable subject, publication authority, and context version. Subject classification is expressed only by subject.type.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "context_version", "subject", "owner"],
      "properties": {
        "name": {
          "description": "Human-readable stable mind name.",
          "type": "string",
          "minLength": 1
        },
        "context_version": {
          "description": "Semantic version of the published durable context instance.",
          "$ref": "#/$defs/stable_semver"
        },
        "subject": {
          "description": "Entity this mind describes and is authoritative about.",
          "$ref": "#/$defs/entity_ref"
        },
        "owner": {
          "description": "Entity accountable for publication of this mind.",
          "$ref": "#/$defs/entity_ref"
        }
      }
    },
    "contract": {
      "description": "Repository-wide guarantees exposed to consumers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_source", "explicit_subject", "explicit_owner", "versioned_context", "human_readable", "machine_readable", "secrets"],
      "properties": {
        "canonical_source": {"const": "required"},
        "explicit_subject": {"const": "required"},
        "explicit_owner": {"const": "required"},
        "versioned_context": {"const": "required"},
        "human_readable": {"const": "required"},
        "machine_readable": {"const": "required"},
        "secrets": {"const": "forbidden"}
      }
    },
    "modules": {
      "description": "Registered modules, architectural rules, and descriptor paths.",
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "registered", "rules", "catalog"],
      "properties": {
        "required": {
          "description": "Module IDs required by every conforming consumer of this publication.",
          "$ref": "#/$defs/module_ids"
        },
        "registered": {
          "description": "Complete set of module IDs published by this mind.",
          "$ref": "#/$defs/module_ids"
        },
        "rules": {
          "description": "Architectural guarantees for registered modules.",
          "type": "object",
          "additionalProperties": false,
          "required": ["single_responsibility", "explicit_dependencies", "independently_replaceable", "duplicate_content", "cross_reference", "composition_over_inheritance"],
          "properties": {
            "single_responsibility": {"const": "required"},
            "explicit_dependencies": {"const": "required"},
            "independently_replaceable": {"const": "required"},
            "duplicate_content": {"const": "forbidden"},
            "cross_reference": {"const": "preferred"},
            "composition_over_inheritance": {"const": "preferred"}
          }
        },
        "catalog": {
          "description": "Repository-relative descriptor path for every registered module.",
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/module_id"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\\.ya?ml$"
          }
        }
      }
    },
    "context": {
      "description": "Stability and visibility vocabulary used by the mind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stability", "visibility"],
      "properties": {
        "stability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable", "transient", "archived"],
          "properties": {
            "stable": {"const": "long_lived_contracts"},
            "transient": {"const": "current_state"},
            "archived": {"const": "ignored_unless_requested"}
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "allowed", "forbidden"],
          "properties": {
            "repository": {"type": "string", "enum": ["public", "private"]},
            "allowed": {"type": "string", "minLength": 1},
            "forbidden": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "loading": {
      "description": "Default and opt-in module loading sets. Modules are the protocol capability-negotiation unit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "optional"],
      "properties": {
        "default": {
          "description": "Modules loaded for every consumer and therefore required to be understood.",
          "$ref": "#/$defs/module_ids"
        },
        "optional": {
          "description": "Modules loaded only when explicitly requested; unknown entries may be ignored when not requested.",
          "$ref": "#/$defs/module_ids"
        }
      }
    },
    "validation": {
      "description": "Machine-readable validation contracts for the manifest and module descriptors.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "module_schema"],
      "properties": {
        "schema": {"const": "schema/mind.schema.json"},
        "module_schema": {"const": "schema/module.schema.json"}
      }
    }
  }
}
