{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiaiaiai.org/mind/schema/protocol/v3",
  "title": "Mind Protocol Descriptor",
  "description": "Implementation-independent descriptor for the canonical Mind Protocol contracts, conformance package, and compatibility policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "contracts", "visual_identity", "conformance", "compatibility", "instance_policy"],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "role"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^schema/[A-Za-z0-9_.-]+\\.json$"
        },
        "role": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 3},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "neutrality"],
      "properties": {
        "id": {"const": "mind"},
        "version": {"$ref": "#/$defs/semver"},
        "neutrality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "publication_owner", "provider", "repository_layout", "runtime"],
          "properties": {
            "subject": {"const": "implementation_independent"},
            "publication_owner": {"const": "implementation_independent"},
            "provider": {"const": "implementation_independent"},
            "repository_layout": {"const": "implementation_independent"},
            "runtime": {"const": "implementation_independent"}
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "module", "identity", "identity_resource", "relationships", "visual_assets", "conformance", "compatibility"],
      "properties": {
        "manifest": {"$ref": "#/$defs/contract"},
        "module": {"$ref": "#/$defs/contract"},
        "identity": {"$ref": "#/$defs/contract"},
        "identity_resource": {"$ref": "#/$defs/contract"},
        "relationships": {"$ref": "#/$defs/contract"},
        "visual_assets": {"$ref": "#/$defs/contract"},
        "conformance": {"$ref": "#/$defs/contract"},
        "compatibility": {"$ref": "#/$defs/contract"}
      }
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_ref_resolution", "integrity", "media_types", "fallback", "avatar"],
      "properties": {
        "asset_ref_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_schema", "discovery", "selection"],
          "properties": {
            "resource_schema": {"const": "schema/visual-assets.schema.json"},
            "discovery": {"const": "registered_typed_resources"},
            "selection": {"const": "unique_matching_ref"}
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor", "algorithm", "required"],
          "properties": {
            "descriptor": {"const": "versioned_descriptor"},
            "algorithm": {"const": "sha256"},
            "required": {"const": true}
          }
        },
        "media_types": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normative", "optional"],
          "properties": {
            "normative": {"const": ["image/svg+xml", "image/png"]},
            "optional": {"const": ["image/webp"]}
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unavailable_mark", "missing_asset", "unsupported_media", "integrity_failure", "derived_visuals"],
          "properties": {
            "unavailable_mark": {"const": "presentation_fallback_allowed_noncanonical"},
            "missing_asset": {"const": "observable_failure_presentation_fallback_allowed_noncanonical"},
            "unsupported_media": {"const": "observable_failure_presentation_fallback_allowed_noncanonical"},
            "integrity_failure": {"const": "hard_failure_presentation_fallback_allowed_noncanonical"},
            "derived_visuals": {"const": "must_not_silently_replace_canonical"}
          }
        },
        "avatar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "presentation_only"}}
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "baseline", "compatibility"],
      "properties": {
        "suite": {"const": "conformance.yaml"},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "source", "persistent_generic_ontology"],
          "properties": {
            "strategy": {"const": "generated_contract_bundle"},
            "source": {"const": "protocol_contract_set"},
            "persistent_generic_ontology": {"const": "forbidden"}
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability_unit", "range_semantics", "unknown_optional_modules", "unknown_required_modules", "unknown_root_manifest_fields"],
          "properties": {
            "capability_unit": {"const": "module"},
            "range_semantics": {"const": "minimum_inclusive_maximum_exclusive"},
            "unknown_optional_modules": {"const": "ignore_when_not_requested"},
            "unknown_required_modules": {"const": "reject"},
            "unknown_root_manifest_fields": {"const": "reject"}
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "status"],
      "properties": {
        "policy": {"const": "compatibility.yaml"},
        "status": {"const": "frozen_pre_1_0"}
      }
    },
    "instance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_instance_branch", "instance_name", "protocol_contracts_are_instance_neutral", "instance_context_is_versioned_independently"],
      "properties": {
        "canonical_instance_branch": {"const": "master"},
        "instance_name": {"const": "mind@{subject.id}"},
        "protocol_contracts_are_instance_neutral": {"const": "required"},
        "instance_context_is_versioned_independently": {"const": "required"}
      }
    }
  }
}
