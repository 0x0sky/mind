{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiaiaiai.org/mind/schema/visual-assets/v1",
  "title": "Mind Canonical Visual Asset Catalog",
  "description": "Concrete publication resource that resolves opaque canonical Identity asset_ref values without changing universal Identity semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assets",
    "validation"
  ],
  "$defs": {
    "asset_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "media_type",
        "resource_path",
        "integrity"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/asset_ref"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image/svg+xml",
            "image/png",
            "image/webp"
          ]
        },
        "resource_path": {
          "description": "Publication-root-relative path. This is packaging metadata, never universal Identity semantics.",
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "const": "schema/visual-assets.schema.json"
        }
      }
    }
  }
}
